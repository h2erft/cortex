# Lets the unprivileged 'cortex' service user reboot / power off the appliance from the UI,
# and nothing else. Installed to /etc/sudoers.d/cortex (mode 0440) by install.sh and kept in
# sync by cortex-update.sh. Validated with `visudo -c` before being put in place.
cortex ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /bin/systemctl reboot, /bin/systemctl poweroff
